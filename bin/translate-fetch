#!/bin/bash
# translate-fetch — translation backend for the Omarchy translate overlay.
#
#   translate-fetch <from> <to> <text>     text as the last argument
#   translate-fetch <from> <to> -          text on stdin
#
# Prints exactly one JSON object on stdout, nothing else on it:
#   {"ok":true,"text":"…","engine":"google","detected":"en"}
#   {"ok":false,"error":"…","engine":"none"}
#
# Engines, tried in order:
#   1. google    clients5.google.com dictionary endpoint — the keyless one the
#                Chrome dictionary extension talks to. Fast, good quality.
#   2. mymemory  api.mymemory.translated.net — keyless, ~5k chars/day anonymous,
#                ~50k when OMARCHY_TRANSLATE_EMAIL is set to any address.
# Override the order with OMARCHY_TRANSLATE_ENGINE=google|mymemory.
#
# Long text is chunked so no single request exceeds what the endpoint accepts,
# and the chunks are rejoined with the newlines they were split on.
#
# Exit status: 0 when the JSON says ok, 1 when no engine could answer, 2 for
# bad arguments. The caller reads stdout either way.

set -uo pipefail

UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0 Safari/537.36"
GOOGLE_CHARS=700    # glyphs per request: even 4-byte glyphs stay inside URL limits
MYMEMORY_CHARS=110  # MyMemory caps one request at 500 bytes; 110 glyphs fits in any script

DETECT_FILE=""
cleanup() { [ -n "$DETECT_FILE" ] && rm -f "$DETECT_FILE"; return 0; }
trap cleanup EXIT

die() { printf 'translate-fetch: %s\n' "$*" >&2; exit 2; }
ok_json() { jq -cn --arg t "$1" --arg e "$2" --arg d "$3" '{ok:true,text:$t,engine:$e,detected:$d}'; }
err_json() { jq -cn --arg e "$1" --arg en "$2" '{ok:false,error:$e,engine:$en}'; }
urlencode() { jq -sRr @uri; }

normalize_lang() {
  case "$1" in
    ""|auto|detect)            printf 'auto' ;;
    zh|zh-CN|zh-cn|zh-Hans)    printf 'zh-CN' ;;
    zh-TW|zh-tw|zh-Hant)       printf 'zh-TW' ;;
    he|iw)                     printf 'he' ;;
    no|nb)                     printf 'no' ;;
    *)
      [[ $1 =~ ^[A-Za-z]{2,3}(-[A-Za-z]{2,4})?$ ]] || die "unsupported language code: $1"
      printf '%s' "$1"
      ;;
  esac
}

[[ $# -ge 2 ]] || die "usage: translate-fetch <from> <to> <text|->"
FROM=$(normalize_lang "$1") || exit 2
TO=$(normalize_lang "$2") || exit 2
[ "$TO" != auto ] || die "'auto' is not a valid target language"
shift 2

if [ $# -eq 0 ] || [ "${1:-}" = "-" ]; then
  [ -t 0 ] && die "no text given and stdin is a terminal"
  TEXT=$(cat)
else
  TEXT="$1"
fi

if [ -z "$TEXT" ]; then ok_json "" none ""; exit 0; fi
if [ "$FROM" = "$TO" ]; then ok_json "$TEXT" none "$FROM"; exit 0; fi
[ "$FROM" != auto ] || DETECT_FILE=$(mktemp)

google_chunk() {
  local enc body code out
  enc=$(printf '%s' "$1" | urlencode)
  body=$(curl -sS --max-time 12 -A "$UA" \
    "https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=$FROM&tl=$TO&q=$enc" \
    -w $'\n%{http_code}' 2>/dev/null) || return 1
  code=${body##*$'\n'}
  body=${body%$'\n'*}
  [[ $code == 2* ]] || return 1
  # A blocked or malformed response is an HTML page, never JSON.
  [ "${body:0:1}" = '[' ] || return 1
  out=$(jq -r 'if (.[0] | type) == "array"
               then ([.[] | if type == "array" then .[0] else . end] | map(tostring) | join(""))
               else (.[0] | tostring) end' <<<"$body" 2>/dev/null) || return 1
  if [ -n "$DETECT_FILE" ]; then
    jq -r 'if (.[0] | type) == "array" then (.[0][1] // "") else "" end' <<<"$body" 2>/dev/null > "$DETECT_FILE"
  fi
  printf '%s' "$out"
}

mymemory_chunk() {
  local enc pair url body code out status
  enc=$(printf '%s' "$1" | urlencode)
  pair="$FROM|$TO"
  [ "$FROM" = auto ] && pair="autodetect|$TO"
  url="https://api.mymemory.translated.net/get?q=$enc&langpair=$(printf '%s' "$pair" | urlencode)"
  [ -n "${OMARCHY_TRANSLATE_EMAIL:-}" ] &&
    url="$url&de=$(printf '%s' "$OMARCHY_TRANSLATE_EMAIL" | urlencode)"
  body=$(curl -sS --max-time 15 -A "$UA" "$url" -w $'\n%{http_code}' 2>/dev/null) || return 1
  code=${body##*$'\n'}
  body=${body%$'\n'*}
  [[ $code == 2* ]] || return 1
  status=$(jq -r '.responseStatus // 0' <<<"$body" 2>/dev/null) || return 1
  [ "$status" = 200 ] || return 1
  out=$(jq -r '.responseData.translatedText // ""' <<<"$body" 2>/dev/null) || return 1
  [ -n "$out" ] || return 1
  # MyMemory reports a spent quota inside the translated text itself.
  case "$out" in
    *"MYMEMORY WARNING"*|*"YOU USED ALL AVAILABLE FREE TRANSLATIONS"*) return 1 ;;
  esac
  if [ -n "$DETECT_FILE" ]; then
    jq -r '.responseData.detectedLanguage // ""' <<<"$body" 2>/dev/null > "$DETECT_FILE"
  fi
  printf '%s' "$out"
}

# NUL-separated chunks, each at most $1 glyphs, split on line breaks.
chunk_text() {
  fold -s -w "$1" | awk -v w="$1" '
    function flush() { if (buf != "") { printf "%s%c", buf, 0; buf = "" } }
    { line[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) {
        l = line[i]
        if (buf == "") buf = l
        else if (length(buf) + 1 + length(l) <= w) buf = buf "\n" l
        else { flush(); buf = l }
      }
      flush()
    }'
}

# Fill OUT with one translated chunk per input chunk. 0 = ok, 1 = failed.
run_engine() {
  local engine="$1" width chunk got
  case "$engine" in
    google) width=$GOOGLE_CHARS ;;
    *)      width=$MYMEMORY_CHARS ;;
  esac
  local -a chunks=()
  mapfile -d '' -t chunks < <(chunk_text "$width" <<<"$TEXT")
  OUT=()
  for chunk in "${chunks[@]}"; do
    if [ -z "$chunk" ]; then OUT+=(""); continue; fi
    if [ "$engine" = google ]; then
      got=$(google_chunk "$chunk") || return 1
    else
      got=$(mymemory_chunk "$chunk") || return 1
    fi
    OUT+=("$got")
  done
  return 0
}

case "${OMARCHY_TRANSLATE_ENGINE:-google}" in
  mymemory) engines=(mymemory google) ;;
  *)        engines=(google mymemory) ;;
esac

OUT=()
for engine in "${engines[@]}"; do
  if run_engine "$engine"; then
    printf -v joined '%s\n' "${OUT[@]}"
    joined=${joined%$'\n'}
    detected="$FROM"
    if [ -n "$DETECT_FILE" ] && [ -s "$DETECT_FILE" ]; then
      detected=$(<"$DETECT_FILE")
      [ -n "$detected" ] || detected="$FROM"
    fi
    ok_json "$joined" "$engine" "$detected"
    exit 0
  fi
done

err_json "no engine answered — check the network or the daily rate limit" none
exit 1
